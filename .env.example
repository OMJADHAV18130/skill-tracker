# ---------------------------------------------------------------------------
# DevPath - Docker Compose environment
# Copy to `.env` before running `docker compose up --build`.
# NEVER commit a real `.env` file.
# ---------------------------------------------------------------------------

# --- Ports -----------------------------------------------------------------
WEB_PORT=5173
API_PORT=8000
POSTGRES_PORT=5432

# --- Database --------------------------------------------------------------
POSTGRES_USER=devpath
POSTGRES_PASSWORD=devpath
POSTGRES_DB=devpath

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-before-production-use
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
BCRYPT_ROUNDS=12

# --- App -------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# The SPA is served by nginx on WEB_PORT and proxies /api to the API service.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seeding / demo account ------------------------------------------------
SEED_ON_STARTUP=true
DEMO_USER_EMAIL=demo@devpath.dev
DEMO_USER_USERNAME=demo
DEMO_USER_PASSWORD=devpath-demo-123
DEMO_USER_FULL_NAME=Demo Learner

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Frontend build --------------------------------------------------------
# Keep /api/v1 for the bundled nginx reverse proxy.
VITE_API_URL=/api/v1
