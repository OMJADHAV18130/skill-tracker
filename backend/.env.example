# ---------------------------------------------------------------------------
# DevPath backend environment
# Copy to `.env` and adjust. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_NAME=DevPath API
API_V1_PREFIX=/api/v1

# --- Database --------------------------------------------------------------
# Docker Compose service name is `db`
DATABASE_URL=postgresql+psycopg://devpath:devpath@localhost:5432/devpath
# Same URL, but from inside the compose network:
# DATABASE_URL=postgresql+psycopg://devpath:devpath@db:5432/devpath
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-before-production-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
BCRYPT_ROUNDS=12

# --- CORS ------------------------------------------------------------------
# Comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seeding / demo --------------------------------------------------------
# Auto-seed the shared roadmap + resources on startup (idempotent)
SEED_ON_STARTUP=true
# Credentials of the local demo account created by `python -m app.db.seed`
DEMO_USER_EMAIL=demo@devpath.dev
DEMO_USER_USERNAME=demo
DEMO_USER_PASSWORD=devpath-demo-123
DEMO_USER_FULL_NAME=Demo Learner

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
